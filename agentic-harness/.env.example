GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Models — Opus 4.7 for all agents. Override MYTHOS_FINDER_MODEL when Mythos is available.
MYTHOS_OPUS_MODEL=publishers/anthropic/models/claude-opus-4-7
MYTHOS_FINDER_MODEL=publishers/anthropic/models/claude-opus-4-7

# Sandbox — runsc (gVisor) for now. Switch to kata-fc when nested virt is available.
MYTHOS_SANDBOX_RUNTIME=runsc
MYTHOS_SANDBOX_MEMORY=8g
